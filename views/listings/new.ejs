<% layout("/layouts/boilerplate") %>
    <h3>Create a new Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation">
        <div>
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]"
             placeholder="enter title" 
             type="text" 
             class="form-control"
             required>
        </div>
        <div>
            <label for="description" class="form-label">Desription</label>
            <textarea name="listing[description]" 
            class="form-control" required >
            </textarea>
        </div>
        <div>
            <label for="image" class="form-label">Image Link</label>
            <input name="listing[image]"
             placeholder="enter image url"
             type="text" class="form-control">
        </div>
       <div>
        <label for="price" class="form-label">Price</label>
        <input name="listing[price]" placeholder="enter price"  class="form-control" required>
       </div>
       <div>
        <label for="country" class="form-label">Country</label>
        <input name="listing[country]" placeholder="enter country" type="text"  class="form-control" required>
       </div>
       <div>
        <label for="location" class="form-label">Location</label>
        <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required>
       </div>
       <br/>
        <button class="btn btn-dark">Add</button>
    </form>
</body>
